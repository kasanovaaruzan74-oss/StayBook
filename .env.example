# Optional environment variables. The application reads the process environment;
# it does not automatically load this file. Defaults work without configuration.
DATABASE_URL=sqlite:///./database.db
SQL_ECHO=0
BACKEND_URL=http://127.0.0.1:8000
# API_URL is accepted as a legacy fallback when BACKEND_URL is unset.
API_URL=http://127.0.0.1:8000
