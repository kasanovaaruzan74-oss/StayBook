# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    BACKEND_URL=http://backend:8000

WORKDIR /app

COPY requirements-frontend.txt ./requirements.txt
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
        PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r requirements.txt; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

RUN groupadd --gid 10001 staybook \
    && useradd --uid 10001 --gid staybook --home-dir /app \
        --shell /usr/sbin/nologin staybook \
    && chown staybook:staybook /app

COPY --chown=staybook:staybook app/frontend ./app/frontend
COPY --chown=staybook:staybook .streamlit ./.streamlit

USER staybook
EXPOSE 8501

CMD ["streamlit", "run", "app/frontend/ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
